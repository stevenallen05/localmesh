// observability/alloy/config.alloy
//
// Ported from archive/cleanroom_experiments/observability_cleanroom.
// Differences vs. the cleanroom (see spec docs/superpowers/specs/
// 2026-05-22-observability-port-design.md):
//   - pyroscope blocks dropped (no profiling in this distribution)
//   - project-name filter on discovery.docker dropped (replaced by an
//     exempt-label drop in discovery.relabel "containers")
//   - otelcol.processor.filter "policy" inserted between the OTLP receiver
//     and the batch processor as the org-policy seam (OTTL, empty default)
//   - discovery.relabel "containers" added; loki.source.docker now reads
//     its output so exempt containers are excluded from log tailing
//   - discovery.docker "scrape_targets" + discovery.relabel "scrape_targets"
//     + prometheus.scrape "labeled_targets" added for docker-label-driven
//     prometheus scraping (com.localmesh.scrape.* vocabulary)

logging {
  level  = "info"
  format = "logfmt"
}

// ──── OTLP receiver — apps push traces, metrics, logs here ────────────
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces  = [otelcol.processor.filter.policy.input]
    metrics = [otelcol.processor.filter.policy.input]
    logs    = [otelcol.processor.filter.policy.input]
  }
}

// ──── Policy filter seam ──────────────────────────────────────────────
// Drop / redact spans/metrics/logs by org policy BEFORE the pipeline
// continues. OTTL syntax. Empty in this distribution; the SRE distribution
// swaps in the org's policy here.
otelcol.processor.filter "policy" {
  // Example shape (commented):
  // traces {
  //   span = [`attributes["http.target"] == "/healthz"`]
  // }
  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces  = [
      otelcol.connector.spanmetrics.default.input,
      otelcol.connector.servicegraph.default.input,
      otelcol.exporter.otlp.tempo.input,
    ]
    metrics = [otelcol.exporter.prometheus.appmetrics.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
  }
}

otelcol.exporter.prometheus "appmetrics" {
  forward_to = [prometheus.remote_write.default.receiver]
}

// Span metrics: traces_spanmetrics_calls_total + duration histograms.
otelcol.connector.spanmetrics "default" {
  histogram {
    explicit {}
  }

  // Attach trace_id exemplars to the duration histogram so latency panels can
  // jump to an exact trace. Prometheus needs --enable-feature=exemplar-storage.
  exemplars {
    enabled = true
  }

  output {
    metrics = [otelcol.exporter.prometheus.spanmetrics.input]
  }
}

otelcol.connector.servicegraph "default" {
  output {
    metrics = [otelcol.exporter.prometheus.servicegraph.input]
  }
}

otelcol.exporter.prometheus "spanmetrics" {
  forward_to = [prometheus.remote_write.default.receiver]
}

otelcol.exporter.prometheus "servicegraph" {
  forward_to = [prometheus.remote_write.default.receiver]
}

// Tempo exporter — gRPC, plaintext, no TLS for localdev.
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// ──── Container log tailing ───────────────────────────────────────────

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// discovery.docker can't express exclusion natively (only equality filters),
// so the exempt drop happens here. Containers labeled
// com.localmesh.observability.exempt=true (the six observability containers
// themselves, plus any user opt-out) are removed before the target set
// reaches loki.source.docker.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_localmesh_observability_exempt"]
    regex         = "true"
    action        = "drop"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.process.containers.receiver]
  labels = {
    job = "docker",
  }
}

loki.process "containers" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level   = "level",
      message = "message",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  stage.match {
    selector = "{level!~\"trace|debug|info|warn|error|fatal|\"}"
    action   = "drop"
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ──── OTLP logs to Loki ───────────────────────────────────────────────
// telemetrygen --logs (and any SDK push) lands here.
otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

// ──── Host metrics ────────────────────────────────────────────────────

prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
}

prometheus.scrape "host_metrics" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// ──── Container metrics (cadvisor) ────────────────────────────────────

prometheus.scrape "cadvisor" {
  targets = [
    { __address__ = "cadvisor:8080", job = "cadvisor" },
  ]
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// ──── Docker-label-driven scrape discovery ────────────────────────────
// Containers opt in with com.localmesh.scrape=true. The relabel stage
// drops exempt containers, drops opt-ins missing the port label, and
// composes __address__ from container name + port label.

discovery.docker "scrape_targets" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.localmesh.scrape=true"]
  }
}

discovery.relabel "scrape_targets" {
  targets = discovery.docker.scrape_targets.targets

  // exempt wins over scrape=true
  rule {
    source_labels = ["__meta_docker_container_label_com_localmesh_observability_exempt"]
    regex         = "true"
    action        = "drop"
  }
  // require port label — fail closed if missing
  rule {
    source_labels = ["__meta_docker_container_label_com_localmesh_scrape_port"]
    regex         = "(.+)"
    action        = "keep"
  }
  // __meta_docker_container_name carries a leading "/"; strip it while
  // joining with the port label so __address__ is "<name>:<port>".
  rule {
    source_labels = [
      "__meta_docker_container_name",
      "__meta_docker_container_label_com_localmesh_scrape_port",
    ]
    separator    = ";"
    regex        = "/([^;]+);(.+)"
    replacement  = "$1:$2"
    target_label = "__address__"
  }
  // optional path override
  rule {
    source_labels = ["__meta_docker_container_label_com_localmesh_scrape_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }
}

prometheus.scrape "labeled_targets" {
  targets         = discovery.relabel.scrape_targets.output
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// ──── Synthetics (blackbox-exporter, embedded in Alloy) ───────────────

prometheus.exporter.blackbox "default" {
  config = "modules:\n  http_2xx:\n    prober: http\n    timeout: 5s\n    http:\n      method: GET\n      preferred_ip_protocol: ip4\n"

  target {
    name    = "grafana_self"
    address = "http://grafana:3000/api/health"
    module  = "http_2xx"
  }
}

prometheus.scrape "blackbox" {
  targets         = prometheus.exporter.blackbox.default.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "30s"
}

// ──── GPU metrics (scaffolded, disabled by default) ───────────────────
// Uncomment on a host with NVIDIA GPUs + the NVIDIA Container Toolkit.
// Also add `runtime: nvidia` to the alloy service in docker-compose.yml.
// TODO: needs_prod_decisions gpu exporter default-on
//
// prometheus.exporter.dcgm "default" {}
//
// prometheus.scrape "gpu" {
//   targets         = prometheus.exporter.dcgm.default.targets
//   forward_to      = [prometheus.remote_write.default.receiver]
//   scrape_interval = "15s"
// }
