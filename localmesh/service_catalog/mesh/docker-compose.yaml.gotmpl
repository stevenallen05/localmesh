services:
  kuma-cp:
    image: docker.io/kumahq/kuma-cp:2.13.6
    # kuma-cp's auto-generated TLS cert SANs are derived from the container
    # hostname; sidecars dial https://kuma-cp:5678 and reject the cert
    # without a matching SAN.
    hostname: kuma-cp
    command: ["run"]
    environment:
      KUMA_MODE: standalone
      KUMA_ENVIRONMENT: universal
      KUMA_STORE_TYPE: memory
      KUMA_API_SERVER_HTTP_INTERFACE: 0.0.0.0
      KUMA_API_SERVER_HTTP_PORT: "5681"
      KUMA_DP_SERVER_PORT: "5678"
      KUMA_DP_SERVER_AUTHN_DP_PROXY_TYPE: none
      # Dev-only: allow unauthenticated callers to manage admin resources
      # (Secrets, MeshGateway) so the bootstrap container needs no token.
      KUMA_ACCESS_STATIC_ADMIN_RESOURCES_GROUPS: "mesh-system:admin,mesh-system:unauthenticated"
    expose:
      - "5678"
    ports:
      - "25681:5681"

  localmesh-dataplane-bootstrap:
    build:
      context: .
      dockerfile: Dockerfile.dataplane
    image: localmesh-dataplane:dev
    entrypoint: ["/bin/bash", "/usr/local/bin/bootstrap.sh"]
    depends_on:
      kuma-cp:
        condition: service_started
    configs:
      - source: mesh_defaults
        target: /etc/localmesh/bootstrap/00-mesh-and-identity.yaml
      - source: ingress_tls_secret
        target: /etc/localmesh/bootstrap/05-ingress-tls.yaml
      - source: ingress_gateway
        target: /etc/localmesh/bootstrap/10-ingress-mesh-gateway.yaml
      - source: allow_all
        target: /etc/localmesh/bootstrap/10-traffic-permission.yaml
      - source: mesh_trace_policy
        target: /etc/localmesh/bootstrap/20-trace.yaml
      - source: ingress_routes
        target: /etc/localmesh/bootstrap/30-ingress-routes.yaml
    restart: "no"

  ingress:
    build:
      context: .
      dockerfile: Dockerfile.dataplane
    image: localmesh-dataplane:dev
    # BUILTIN gateway dataplane. Gateways don't transparent-proxy, so no
    # NET_ADMIN; kuma fills the dataplane address var via --dataplane-var.
    # entrypoint:[] overrides the image's sidecar-init.sh ENTRYPOINT so
    # the command below runs kuma-dp directly (no workload init).
    # `$$` is Compose's variable-escape (renders to `$` at runtime); `\$$1`
    # reaches awk as `$1`.
    entrypoint: []
    command:
      - /bin/bash
      - -c
      - 'APP_ADDR=$$(hostname -i | awk "{print \$$1}"); exec /usr/local/bin/kuma-dp run --cp-address=https://kuma-cp:5678 --dataplane-file=/etc/kuma/ingress.yaml --dataplane-var=address=$$APP_ADDR'
    configs:
      - source: ingress_dataplane
        target: /etc/kuma/ingress.yaml
    ports:
      - "8443:8443"
    depends_on:
      kuma-cp:
        condition: service_started
      localmesh-dataplane-bootstrap:
        condition: service_completed_successfully
    restart: unless-stopped
{{- range .Services }}
{{- if ne .Plugin "mesh" }}

  {{ .Name }}-mesh:
    build:
      context: .
      dockerfile: Dockerfile.dataplane
    image: localmesh-dataplane:dev
    network_mode: "service:{{ .Name }}"
    cap_add:
      - NET_ADMIN
      - NET_RAW
    configs:
      - source: transparent_proxy
        target: /etc/kuma/transparent-proxy.yaml
    environment:
      WORKLOAD_NAME: {{ .Name }}
      APP_PORT: "{{ .Port }}"
      APP_PROTOCOL: "{{ .Protocol }}"
      CP_HOST: kuma-cp:5678
    depends_on:
      {{ .Name }}:
        condition: service_started
      kuma-cp:
        condition: service_started
      localmesh-dataplane-bootstrap:
        condition: service_completed_successfully
    restart: unless-stopped
{{- end }}
{{- end }}

configs:
  mesh_defaults:
    file: ./bootstrap/00-mesh-and-identity.yaml
  # Rendered inline (not file:) so the listener `hostname` field can use
  # template substitution. Adopts the same pattern as ingress_routes.
  ingress_gateway:
    content: |
      type: MeshGateway
      mesh: default
      name: ingress
      selectors:
        - match:
            kuma.io/service: ingress
      conf:
        listeners:
          - port: 8443
            protocol: HTTPS
            hostname: '*.{{ .Project.Name }}.{{ .Project.LocalDomain }}'
            tls:
              mode: TERMINATE
              certificates:
                - secret: ingress-tls
            tags:
              port: https-ingress
  ingress_tls_secret:
    file: ../../secrets/ingress-tls/secret.yaml
  allow_all:
    file: ./bootstrap/10-traffic-permission.yaml
  mesh_trace_policy:
    file: ./bootstrap/20-trace.yaml
  ingress_dataplane:
    file: ./dataplane/ingress.yaml
  transparent_proxy:
    content: |
      kumaDPUser: kuma-data-plane-proxy
      redirect:
        dns:
          enabled: true
      verbose: true
  # Rendered inline (not file:) so per-service routes use the template context.
  # Block-scalar body: indentation is content; `---` separates each route doc.
  ingress_routes:
    content: |
{{- range .Services }}
{{- if .ExposeViaIngress }}
      ---
      type: MeshHTTPRoute
      mesh: default
      name: ingress-route-{{ .Name }}
      spec:
        targetRef:
          kind: MeshGateway
          name: ingress
          tags:
            port: https-ingress
        to:
          - targetRef:
              kind: Mesh
            hostnames:
              - {{ .Name }}.{{ $.Project.Name }}.{{ $.Project.LocalDomain }}
            rules:
              - matches:
                  - path:
                      type: PathPrefix
                      value: "/"
                default:
                  backendRefs:
                    - kind: MeshService
                      name: {{ .Name }}
                      port: {{ .Port }}
{{- end }}
{{- end }}
