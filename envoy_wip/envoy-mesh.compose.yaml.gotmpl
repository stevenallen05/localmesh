# Rendered by the bundling CLI. Sprig context expected:
#   .project_name           — from project.toml
#   .local_domain           — from project.toml
#   .tech_lead_email        — from project.toml [identity]
#   .ingress_external_host  — from project.toml
#   .workloads              — [{ name, listeners[], upstreams[], policy_path }]
#                             collected from plugin.toml [[services]] + compose
#   .otel_endpoint          — from observability/ plugin
#   .dex_issuer             — from auth/ plugin
#   .dex_jwks_uri           — from auth/ plugin
#
# Until the CLI's catalog pass lands, .workloads is empty and only the
# two gateway services render. The rendered envoy configs land in
# envoy_wip/rendered/ (gitignored), mounted by each container.

services:
  ingress-mesh:
    image: envoyproxy/envoy:v1.31-latest
    restart: unless-stopped
    ports:
      - "8443:8443"
    volumes:
      - ./.secrets/certs/ingress-mesh:/run/ingress-mesh:ro
      - ./envoy_wip/rendered/ingress-gateway.yaml:/etc/envoy/envoy.yaml:ro
    environment:
      OTEL_SERVICE_NAME: ingress-mesh
      OTEL_RESOURCE_ATTRIBUTES: "service.namespace={{ .project_name }},deployment.environment.name=dev,module_name=mesh,owned_by=sre@example.com"
    labels:
      metrics.service_name:    envoy
      metrics.module_name:     mesh
      metrics.owned_by:        sre@example.com
      mesh.role:               ingress
      mesh.envoy.admin_port:   "15000"
      mesh.envoy.stats_port:   "15090"

  egress-mesh:
    image: envoyproxy/envoy:v1.31-latest
    restart: unless-stopped
    volumes:
      - ./.secrets/certs/egress-mesh:/run/egress-mesh:ro
      - ./.secrets/policy:/var/mesh/policy:ro
      - ./envoy_wip/rendered/egress-gateway.yaml:/etc/envoy/envoy.yaml:ro
    environment:
      OTEL_SERVICE_NAME: egress-mesh
      OTEL_RESOURCE_ATTRIBUTES: "service.namespace={{ .project_name }},deployment.environment.name=dev,module_name=mesh,owned_by=sre@example.com"
    labels:
      metrics.service_name:    envoy
      metrics.module_name:     mesh
      metrics.owned_by:        sre@example.com
      mesh.role:               egress
      mesh.envoy.admin_port:   "15000"
      mesh.envoy.stats_port:   "15090"

{{- range $w := .workloads }}
  {{ $w.name }}-mesh:
    image: envoyproxy/envoy:v1.31-latest
    restart: unless-stopped
    # Share the workload's netns. App binds plaintext on loopback;
    # sidecar terminates mTLS on the workload's declared east-west port.
    network_mode: "service:{{ $w.name }}"
    volumes:
      - ./.secrets/certs/{{ $w.name }}:/run/{{ $w.name }}:ro
      - ./.secrets/policy/{{ $w.name }}.policy.json:/var/mesh/policy/id.policy.json:ro
      - ./envoy_wip/rendered/{{ $w.name }}-sidecar.yaml:/etc/envoy/envoy.yaml:ro
    environment:
      OTEL_SERVICE_NAME: {{ $w.name }}-mesh
      OTEL_RESOURCE_ATTRIBUTES: "service.namespace={{ $.project_name }},deployment.environment.name=dev,module_name=mesh,owned_by=sre@example.com"
    depends_on:
      {{ $w.name }}:
        condition: service_started
    labels:
      metrics.service_name:    envoy
      metrics.module_name:     mesh
      metrics.owned_by:        sre@example.com
      mesh.role:               sidecar
      mesh.envoy.admin_port:   "15000"
      mesh.envoy.stats_port:   "15090"
{{- end }}
