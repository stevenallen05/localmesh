{{/*
North-south ingress. Replaces caddy + oauth2-proxy with one Envoy.

Context expected:
  .service_name        — "ingress-mesh"
  .cert_dir            — /run/ingress-mesh (step-ca wildcard cert)
  .external_host       — *.{{ .project_name }}.{{ .local_domain }}
  .dex_issuer          — http://dex:5556/dex
  .dex_jwks_uri        — http://dex:5556/dex/keys
  .oauth2_client_id    — from auth/ plugin secrets
  .oauth2_client_secret — from auth/ plugin secrets
  .routes[]            — [{ host, cluster, upstream_host, upstream_port, upstream_spiffe_uri }]
                         one entry per workload with expose_via_ingress=true
  .otel_endpoint_host  — observability/ host
  .otel_endpoint_port  — observability/ port

Pipeline (top-to-bottom on every request):
  1. TLS terminate on :8443 with wildcard cert.
  2. oauth2 filter: if no session cookie, redirect to Dex; on callback,
     exchange code → tokens, set session cookie.
  3. jwt_authn: validate the ID token from the session via Dex JWKS.
     payload_in_metadata = jwt_payload (downstream filters read it).
  4. header_to_metadata + Lua (or extproc) stamp claims onto headers:
       x-user-id    ← sub
       x-user-email ← email
       x-user-name  ← name
       x-jwt-kid    ← header.kid (for log forensics)
  5. router → mTLS upstream to the target workload's mesh sidecar.

Row coverage:
- 1, 2, 4, 5, 6: identical to workload sidecar via _helpers.
- 12 (out-of-MVP, but the JWT path lands here): JWT is validated once
  here. Downstream sidecars trust x-user-* headers because the ingress
  is the only entry point. Egress sidecars strip x-user-* by default
  on outbound (PII at ingress only).
*/}}
{{ include "mesh.envoy.admin" . }}

node:
  id:      ingress-mesh
  cluster: ingress-mesh

{{ include "mesh.envoy.otel_tracing" (dict "service_name" .service_name) }}

static_resources:
  listeners:
  - name: ingress_https
    address:
      socket_address: { address: 0.0.0.0, port_value: 8443 }
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
        common_tls_context:
          tls_certificates:
          - certificate_chain: { filename: "{{ .cert_dir }}/id.crt" }
            private_key:       { filename: "{{ .cert_dir }}/id.key" }
          tls_params:
            tls_minimum_protocol_version: TLSv1_3
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: ingress_https
          codec_type: AUTO
          {{ include "mesh.envoy.access_log" . | indent 10 }}
          route_config:
            virtual_hosts:
{{- range $r := .routes }}
            - name: {{ $r.cluster }}
              domains: ["{{ $r.host }}"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: {{ $r.cluster }} }
{{- end }}
          http_filters:
          - name: envoy.filters.http.oauth2
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.oauth2.v3.OAuth2
              config:
                token_endpoint:
                  cluster:           dex
                  uri:               "{{ .dex_issuer }}/token"
                  timeout:           5s
                authorization_endpoint: "{{ .dex_issuer }}/auth"
                redirect_uri:           "https://{{ .external_host }}:8443/oauth2/callback"
                redirect_path_matcher:  { path: { exact: "/oauth2/callback" } }
                signout_path:           { path: { exact: "/oauth2/signout" } }
                credentials:
                  client_id:            "{{ .oauth2_client_id }}"
                  token_secret:
                    name: client_secret
                    sds_config:
                      path_config_source:
                        path: /run/ingress-mesh/oauth2.secret.yaml
                  hmac_secret:
                    name: hmac
                    sds_config:
                      path_config_source:
                        path: /run/ingress-mesh/hmac.secret.yaml
                # Append the ID token onto a downstream header so jwt_authn
                # below can validate it. Default behaviour places it in
                # `Authorization: Bearer <id-token>`.
                forward_bearer_token: true
                auth_scopes:
                - openid
                - email
                - profile
                resources:
                - "{{ .external_host }}"
          - name: envoy.filters.http.jwt_authn
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
              providers:
                dex:
                  issuer:   "{{ .dex_issuer }}"
                  audiences:
                  - "{{ .oauth2_client_id }}"
                  remote_jwks:
                    http_uri:
                      uri:     "{{ .dex_jwks_uri }}"
                      cluster: dex
                      timeout: 5s
                    cache_duration: 900s
                  payload_in_metadata: jwt_payload
                  header_in_metadata:  jwt_header
              rules:
              - match: { prefix: "/oauth2/" }
                requires: { provider_name: "" }
              - match: { prefix: "/" }
                requires: { provider_name: "dex" }
          - name: envoy.filters.http.header_mutation
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation
              # Stamp claims onto headers from jwt_authn's dynamic metadata.
              # The CLI populates this from the auth/ plugin's claim map.
              mutations:
                request_mutations:
                - append:
                    header: { key: "x-user-id",    value: "%DYNAMIC_METADATA(envoy.filters.http.jwt_authn:jwt_payload:sub)%" }
                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                - append:
                    header: { key: "x-user-email", value: "%DYNAMIC_METADATA(envoy.filters.http.jwt_authn:jwt_payload:email)%" }
                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                - append:
                    header: { key: "x-user-name",  value: "%DYNAMIC_METADATA(envoy.filters.http.jwt_authn:jwt_payload:name)%" }
                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
                - append:
                    header: { key: "x-jwt-kid",    value: "%DYNAMIC_METADATA(envoy.filters.http.jwt_authn:jwt_header:kid)%" }
                    append_action: OVERWRITE_IF_EXISTS_OR_ADD
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  {{ include "mesh.envoy.stats_listener" . | indent 2 }}

  clusters:
  - name: dex
    type: STRICT_DNS
    connect_timeout: 1s
    load_assignment:
      cluster_name: dex
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: dex, port_value: 5556 }

{{- range $r := .routes }}
  - name: {{ $r.cluster }}
    type: STRICT_DNS
    connect_timeout: 0.250s
    http2_protocol_options: {}
    load_assignment:
      cluster_name: {{ $r.cluster }}
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: {{ $r.upstream_host }}, port_value: {{ $r.upstream_port }} }
    {{ include "mesh.envoy.mtls_upstream" (dict "cert_dir" $.cert_dir) | indent 4 }}
{{- end }}

  {{ include "mesh.envoy.otel_cluster" . | indent 2 }}
  {{ include "mesh.envoy.stats_admin_cluster" . | indent 2 }}
