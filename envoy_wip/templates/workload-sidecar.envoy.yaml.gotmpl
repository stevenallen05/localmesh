{{/*
Per-workload envoy sidecar.

Context expected:
  .name                — workload short name (e.g. "www", "server")
  .service_name        — OTEL_SERVICE_NAME (typically "{{ .name }}-mesh")
  .cert_dir            — path mounted in the container (/run/{{ .name }})
  .policy_path         — path to id.policy.json in the container
  .inbound[]           — [{ port, app_loopback_port, protocol }]
                         port: east-west listener port (mTLS)
                         app_loopback_port: plaintext app bind on shared netns
                         protocol: http2 | tcp
  .upstreams[]         — [{ cluster, host, port, spiffe_uri }] for outbound
                         clusters the app dials directly (named clusters in
                         the bootstrap, not the catch-all egress path)
  .otel_endpoint_host  — observability/ host
  .otel_endpoint_port  — observability/ port

Row coverage (from scratch.envoy-omakase.md):
- 1 OTel spans: tracing block via _helpers.
- 2 Stats endpoint: stats listener via _helpers.
- 4 Request ID: request_id_extension on each HCM (default behaviour).
- 5 XFCC: forward_client_cert_details: SANITIZE_SET, set_current_client_cert_details on inbound.
- 6 Access logs: JSON schema via _helpers.
- 7 mTLS east-west: downstream + upstream TLS contexts via _helpers.
- 14 Cert-as-policy inbound: RBAC filter sources allow list from
     id.policy.json (rendered into the RBAC config by the CLI's policy-
     loader pass). For MVP, allowed_peers becomes a permission list
     against principals.uri_san matching.

Outbound row 13 lands on the catch-all cluster pointing at egress-mesh.
*/}}
{{ include "mesh.envoy.admin" . }}

node:
  id:      {{ .name }}-mesh
  cluster: {{ .name }}

{{ include "mesh.envoy.otel_tracing" (dict "service_name" .service_name) }}

static_resources:
  listeners:

{{- range $l := .inbound }}
  - name: inbound-{{ $l.port }}
    address:
      socket_address: { address: 0.0.0.0, port_value: {{ $l.port }} }
    {{ include "mesh.envoy.mtls_downstream" (dict "cert_dir" $.cert_dir) | indent 4 }}
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: inbound_{{ $l.port }}
          codec_type: AUTO
          forward_client_cert_details: SANITIZE_SET
          set_current_client_cert_details:
            uri:    true
            subject: true
          {{ include "mesh.envoy.access_log" . | indent 10 }}
          route_config:
            virtual_hosts:
            - name: inbound
              domains: ["*"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: app_loopback }
          http_filters:
          - name: envoy.filters.http.rbac
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
              # Populated from id.policy.json by the CLI's policy-loader.
              # Until then, an empty allow list = deny-all.
              # TODO: needs_prod_decisions cert-policy loader for inbound RBAC
              rules:
                action: ALLOW
                policies: {}
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
{{- end }}

  # Catch-all outbound: every dial that isn't a named upstream lands here
  # and gets forwarded to egress-mesh for cert-policy gating. The CLI
  # injects iptables redirect rules (or compose-level DNS overrides) so
  # the app's plaintext loopback dials hit this listener.
  - name: outbound_catchall
    address:
      socket_address: { address: 127.0.0.1, port_value: 15001 }
    filter_chains:
    - filters:
      - name: envoy.filters.network.tcp_proxy
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
          stat_prefix: outbound_catchall
          cluster: egress_mesh

  {{ include "mesh.envoy.stats_listener" . | indent 2 }}

  clusters:
  - name: app_loopback
    type: STATIC
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: app_loopback
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: 127.0.0.1, port_value: {{ (index .inbound 0).app_loopback_port }} }

  - name: egress_mesh
    type: STRICT_DNS
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: egress_mesh
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: egress-mesh, port_value: 15001 }
    {{ include "mesh.envoy.mtls_upstream" (dict "cert_dir" .cert_dir) | indent 4 }}

{{- range $u := .upstreams }}
  - name: {{ $u.cluster }}
    type: STRICT_DNS
    connect_timeout: 0.250s
    http2_protocol_options: {}
    load_assignment:
      cluster_name: {{ $u.cluster }}
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: {{ $u.host }}, port_value: {{ $u.port }} }
    {{ include "mesh.envoy.mtls_upstream" (dict "cert_dir" $.cert_dir) | indent 4 }}
{{- end }}

  {{ include "mesh.envoy.otel_cluster" . | indent 2 }}
  {{ include "mesh.envoy.stats_admin_cluster" . | indent 2 }}
