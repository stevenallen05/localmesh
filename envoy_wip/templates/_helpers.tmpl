{{/*
Shared template blocks for envoy bootstrap configs.

Locked-in omakase from scratch.envoy-omakase.md (rows 1, 2, 4, 5, 6, 7,
13, 14). Each block here corresponds to an omakase row that every role
inherits without per-template effort.

- admin: row "always-on, no dashboard" — open in dev, prod's call.
- stats_listener: row 2 — every workload exposes RED on :15090.
- otel_tracing: row 1 — every cross-service hop emits a span.
- access_log: row 6 — JSON schema locked here. Carries trace_id,
  request_id, peer SPIFFE URI, peer cert serial, jwt_kid. No user_id
  in logs (lives on the trace as an attribute, stamped by the ingress).
- otel_cluster + stats_cluster: upstreams used by tracing + stats.

Context expected by each block is documented inline.
*/}}

{{- define "mesh.envoy.admin" -}}
admin:
  address:
    socket_address:
      address: 0.0.0.0
      port_value: 15000
{{- end }}

{{/* Context: . = { service_name } */}}
{{- define "mesh.envoy.otel_tracing" -}}
tracing:
  http:
    name: envoy.tracers.opentelemetry
    typed_config:
      "@type": type.googleapis.com/envoy.config.trace.v3.OpenTelemetryConfig
      grpc_service:
        envoy_grpc:
          cluster_name: otel_collector
        timeout: 0.250s
      service_name: {{ .service_name }}
{{- end }}

{{- define "mesh.envoy.access_log" -}}
access_log:
- name: envoy.access_loggers.stdout
  typed_config:
    "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
    log_format:
      json_format:
        time:             "%START_TIME%"
        method:           "%REQ(:METHOD)%"
        path:              "%REQ(X-ENVOY-ORIGINAL-PATH?:PATH)%"
        status:           "%RESPONSE_CODE%"
        duration_ms:      "%DURATION%"
        bytes_recv:       "%BYTES_RECEIVED%"
        bytes_sent:       "%BYTES_SENT%"
        upstream_cluster: "%UPSTREAM_CLUSTER%"
        request_id:       "%REQ(X-REQUEST-ID)%"
        trace_id:         "%REQ(TRACEPARENT)%"
        peer_spiffe_uri:  "%DOWNSTREAM_PEER_URI_SAN%"
        peer_cert_serial: "%DOWNSTREAM_PEER_SERIAL%"
        jwt_kid:          "%REQ(X-JWT-KID)%"
{{- end }}

{{- define "mesh.envoy.stats_listener" -}}
- name: stats
  address:
    socket_address: { address: 0.0.0.0, port_value: 15090 }
  filter_chains:
  - filters:
    - name: envoy.filters.network.http_connection_manager
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
        stat_prefix: stats
        route_config:
          virtual_hosts:
          - name: stats
            domains: ["*"]
            routes:
            - match: { prefix: "/stats/prometheus" }
              route: { cluster: prom_stats_admin }
        http_filters:
        - name: envoy.filters.http.router
          typed_config:
            "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
{{- end }}

{{/* Context: . = { otel_endpoint } (host:port for otel-collector gRPC) */}}
{{- define "mesh.envoy.otel_cluster" -}}
- name: otel_collector
  type: STRICT_DNS
  connect_timeout: 1s
  http2_protocol_options: {}
  load_assignment:
    cluster_name: otel_collector
    endpoints:
    - lb_endpoints:
      - endpoint:
          address:
            socket_address:
              address:    {{ .otel_endpoint_host }}
              port_value: {{ .otel_endpoint_port }}
{{- end }}

{{- define "mesh.envoy.stats_admin_cluster" -}}
- name: prom_stats_admin
  type: STATIC
  connect_timeout: 0.250s
  load_assignment:
    cluster_name: prom_stats_admin
    endpoints:
    - lb_endpoints:
      - endpoint:
          address:
            socket_address: { address: 127.0.0.1, port_value: 15000 }
{{- end }}

{{/*
Context: . = { cert_dir }
Standard TLS context for mTLS where step-ca-minted certs live at
{cert_dir}/{id.crt, id.key, trust.ca.crt}.
*/}}
{{- define "mesh.envoy.mtls_downstream" -}}
transport_socket:
  name: envoy.transport_sockets.tls
  typed_config:
    "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
    require_client_certificate: true
    common_tls_context:
      tls_certificates:
      - certificate_chain: { filename: "{{ .cert_dir }}/id.crt" }
        private_key:       { filename: "{{ .cert_dir }}/id.key" }
      validation_context:
        trusted_ca:        { filename: "{{ .cert_dir }}/trust.ca.crt" }
      tls_params:
        tls_minimum_protocol_version: TLSv1_3
{{- end }}

{{- define "mesh.envoy.mtls_upstream" -}}
transport_socket:
  name: envoy.transport_sockets.tls
  typed_config:
    "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
    common_tls_context:
      tls_certificates:
      - certificate_chain: { filename: "{{ .cert_dir }}/id.crt" }
        private_key:       { filename: "{{ .cert_dir }}/id.key" }
      validation_context:
        trusted_ca:        { filename: "{{ .cert_dir }}/trust.ca.crt" }
      tls_params:
        tls_minimum_protocol_version: TLSv1_3
{{- end }}
