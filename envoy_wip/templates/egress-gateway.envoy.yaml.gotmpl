{{/*
Egress gateway. Receives outbound from every workload sidecar's catch-all
outbound listener; gates by the caller's mTLS cert + per-caller policy
file mounted at /var/mesh/policy/<workload>.policy.json.

Context expected:
  .service_name        — "egress-mesh"
  .cert_dir            — /run/egress-mesh
  .externals[]         — [{ cluster, host, port, tls }] from project-wide
                         catalog (declared by workloads in plugin.toml).
                         Empty in the demo until a workload declares
                         an external destination.
  .otel_endpoint_host  — observability/ host
  .otel_endpoint_port  — observability/ port

Row 13 lands here.

For MVP, policy enforcement is a placeholder. The full sequence is:
  1. mTLS terminate; peer SPIFFE URI in DOWNSTREAM_PEER_URI_SAN.
  2. Init-time reader (sidecar to this container) parses every
     /var/mesh/policy/*.policy.json into an RBAC policy keyed by the
     workload's SPIFFE URI. For each upstream cluster, a policy
     fragment lists which callers are allowed.
  3. envoy.filters.http.rbac evaluates per request.

Today this template wires the listener + clusters; the RBAC rules
remain empty until the policy-loader lands.
TODO: needs_prod_decisions egress policy-loader shape
*/}}
{{ include "mesh.envoy.admin" . }}

node:
  id:      egress-mesh
  cluster: egress-mesh

{{ include "mesh.envoy.otel_tracing" (dict "service_name" .service_name) }}

static_resources:
  listeners:
  - name: egress_in
    address:
      socket_address: { address: 0.0.0.0, port_value: 15001 }
    {{ include "mesh.envoy.mtls_downstream" (dict "cert_dir" .cert_dir) | indent 4 }}
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: egress_in
          codec_type: AUTO
          {{ include "mesh.envoy.access_log" . | indent 10 }}
          route_config:
            virtual_hosts:
{{- range $e := .externals }}
            - name: {{ $e.cluster }}
              domains: ["{{ $e.host }}"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: {{ $e.cluster }} }
{{- end }}
            - name: deny_default
              domains: ["*"]
              routes:
              - match: { prefix: "/" }
                direct_response:
                  status: 403
                  body: { inline_string: "egress denied: destination not in policy\n" }
          http_filters:
          - name: envoy.filters.http.rbac
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
              # Populated by the policy-loader from /var/mesh/policy/*.policy.json.
              rules:
                action: ALLOW
                policies: {}
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  {{ include "mesh.envoy.stats_listener" . | indent 2 }}

  clusters:
{{- range $e := .externals }}
  - name: {{ $e.cluster }}
    type: STRICT_DNS
    connect_timeout: 1s
    load_assignment:
      cluster_name: {{ $e.cluster }}
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: {{ $e.host }}, port_value: {{ $e.port }} }
  {{- if $e.tls }}
    transport_socket:
      name: envoy.transport_sockets.tls
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext
        sni: {{ $e.host }}
  {{- end }}
{{- end }}

  {{ include "mesh.envoy.otel_cluster" . | indent 2 }}
  {{ include "mesh.envoy.stats_admin_cluster" . | indent 2 }}
