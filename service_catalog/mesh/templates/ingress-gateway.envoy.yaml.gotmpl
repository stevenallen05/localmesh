{{/*
Ingress envoy: north-south HTTPS, OIDC dance via dex, JWT validation,
claim-to-header injection, mTLS origination to workload sidecars.

Context: IngressCtx
  .ProjectName, .LocalDomain, .ExternalDomain
  .Routes []IngressRoute       — workloads with expose_via_ingress=true
  .AdminTargets []AdminTarget  — for envoy.<project>.<domain> admin VH
  .OTelEndpoint                — otel-collector:4317
  Runtime (.env interpolation):
    OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, DEX_ISSUER, DEX_JWKS_URI
*/}}
admin:
  address:
    socket_address: { address: 0.0.0.0, port_value: 15000 }

node:
  id: ingress-mesh
  cluster: ingress-mesh

{{ include "mesh.envoy.tracing" (dict "ServiceName" "ingress-mesh" "Endpoint" .OTelEndpoint) }}

static_resources:
  listeners:
  - name: ingress
    address:
      socket_address: { address: 0.0.0.0, port_value: 8443 }
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: ingress
          codec_type: AUTO
          {{ include "mesh.envoy.access_log" . | indent 10 }}
          route_config:
            virtual_hosts:
            {{- range $r := .Routes }}
            - name: {{ $r.Cluster }}
              domains: ["{{ $r.Host }}"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: {{ $r.Cluster }} }
            {{- end }}
            - name: envoy_admin
              domains: ["envoy.{{ .ProjectName }}.{{ .LocalDomain }}"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: ingress_self_admin }
              {{- range $t := .AdminTargets }}{{ if $t.Name }}
              - match: { prefix: "/workload/{{ $t.Name }}/" }
                route: { cluster: {{ $t.Name }}_admin, prefix_rewrite: "/" }
              {{- end }}{{ end }}
          http_filters:
          - name: envoy.filters.http.oauth2
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.oauth2.v3.OAuth2
              config:
                token_endpoint:
                  cluster: dex
                  uri: ${DEX_ISSUER}/token
                  timeout: 5s
                authorization_endpoint: ${DEX_ISSUER}/auth
                redirect_uri: "https://www.{{ .ProjectName }}.{{ .LocalDomain }}:8443/oauth2/callback"
                redirect_path_matcher: { path: { exact: /oauth2/callback } }
                signout_path: { path: { exact: /oauth2/signout } }
                credentials:
                  client_id: ${OIDC_CLIENT_ID}
                  token_secret: { name: client-secret }
                  hmac_secret:  { name: hmac-secret }
                auth_scopes: [ openid, email, profile ]
                # Skip auth on dex.*, envoy.*, grafana.*
                pass_through_matcher:
                {{- range $r := .Routes }}{{ if not $r.RequiresAuth }}
                - name: ":authority"
                  string_match: { exact: "{{ $r.Host }}" }
                {{- end }}{{ end }}
                - name: ":authority"
                  string_match: { exact: "envoy.{{ .ProjectName }}.{{ .LocalDomain }}" }
          - name: envoy.filters.http.jwt_authn
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
              providers:
                dex:
                  issuer: ${DEX_ISSUER}
                  remote_jwks: { http_uri: { uri: "${DEX_JWKS_URI}", cluster: dex, timeout: 5s }, cache_duration: { seconds: 300 } }
                  forward: true
                  payload_in_metadata: jwt_claims
                  claim_to_headers:
                  - { header_name: x-user-id,    claim_name: sub }
                  - { header_name: x-user-email, claim_name: email }
                  - { header_name: x-user-name,  claim_name: preferred_username }
              rules:
              {{- range $r := .Routes }}{{ if $r.RequiresAuth }}
              - match: { prefix: "/" }
                requires: { provider_name: dex }
              {{- end }}{{ end }}
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
      {{ include "mesh.envoy.tls_terminate_self_signed" (dict "CertDir" "/run/ingress-mesh") | indent 6 | trim }}

  - name: stats
    address: { socket_address: { address: 0.0.0.0, port_value: 15090 } }
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: stats
          codec_type: AUTO
          route_config:
            virtual_hosts:
            - name: stats
              domains: ["*"]
              routes:
              - match: { prefix: "/stats/prometheus" }
                route: { cluster: admin_loopback }
          http_filters:
          - name: envoy.filters.http.router
            typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router }

  clusters:
  {{- range $r := .Routes }}
  - name: {{ $r.Cluster }}
    type: STRICT_DNS
    connect_timeout: 1s
    http2_protocol_options: {}
    load_assignment:
      cluster_name: {{ $r.Cluster }}
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: {{ $r.Cluster }}, port_value: {{ $r.Port }} }
    {{ if not $r.RequiresAuth }}{{/* dex, grafana — mesh-exempt, plaintext or self-TLS, no mesh mTLS */}}{{ else }}
    {{ include "mesh.envoy.mtls_upstream" (dict "CertDir" "/run/ingress-mesh") | indent 4 }}
    {{ end }}
  {{- end }}

  - name: dex
    type: STRICT_DNS
    connect_timeout: 1s
    load_assignment:
      cluster_name: dex
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: dex, port_value: 5556 }

  - name: ingress_self_admin
    type: STATIC
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: ingress_self_admin
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: 127.0.0.1, port_value: 15000 }

  - name: admin_loopback
    type: STATIC
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: admin_loopback
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: 127.0.0.1, port_value: 15000 }

  {{- range $t := .AdminTargets }}{{ if $t.Name }}
  - name: {{ $t.Name }}_admin
    type: STRICT_DNS
    connect_timeout: 1s
    load_assignment:
      cluster_name: {{ $t.Name }}_admin
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: {{ $t.Name }}, port_value: 15000 }
  {{- end }}{{ end }}

  {{ include "mesh.envoy.otel_cluster" (dict "Endpoint" .OTelEndpoint) | indent 2 }}

  secrets:
  - name: client-secret
    generic_secret:
      secret: { inline_string: "${OIDC_CLIENT_SECRET}" }
  - name: hmac-secret
    generic_secret:
      secret: { inline_string: "${OAUTH2_HMAC_SECRET}" }
