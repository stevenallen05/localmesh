{{/*
Ingress envoy: north-south HTTPS, OIDC dance via dex, JWT validation,
claim-to-header injection, mTLS origination to workload sidecars.

Context: IngressCtx
  .ProjectName, .LocalDomain, .ExternalDomain
  .Routes []IngressRoute       — workloads with expose_via_ingress=true
  .AdminTargets []AdminTarget  — for envoy.<project>.<domain> admin VH
  .OTelEndpoint                — otel-collector:4317

oauth2 + jwt_authn pair: oauth2 drives the dance for unauthenticated
browsers (302 → dex, callback → cookie), jwt_authn validates the bearer
on every subsequent request. token + hmac secrets arrive as SDS file
documents at /run/ingress-mesh/oauth2-*.yaml. File-based SDS sidesteps
the v1.31 static_resources.secrets duplicate-name auto-registration.
*/}}
admin:
  address:
    socket_address: { address: 0.0.0.0, port_value: 15000 }

node:
  id: ingress-mesh
  cluster: ingress-mesh

{{ include "mesh.envoy.tracing" (dict "ServiceName" "ingress-mesh" "Endpoint" .OTelEndpoint) }}

static_resources:
  listeners:
  - name: ingress
    address:
      socket_address: { address: 0.0.0.0, port_value: 8443 }
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: ingress
          codec_type: AUTO
          # Strip :PORT from Host before VH matching so VH `domains:`
          # entries don't need to enumerate every listener port (browser
          # hits :18443 today, :8443 once caddy retires in Chunk 5).
          strip_matching_host_port: true
          {{ include "mesh.envoy.access_log" . | indent 10 }}
          route_config:
            virtual_hosts:
            {{- range $r := .Routes }}
            - name: {{ $r.Cluster }}
              domains: ["{{ $r.Host }}"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: {{ $r.Cluster }} }
            {{- end }}
            - name: envoy_admin
              domains: ["envoy.{{ .ProjectName }}.{{ .LocalDomain }}"]
              # Admin VH is unauthenticated for now (dev convenience).
              # oauth2 + jwt_authn skip is via pass_through_matcher and
              # rule-host-scoping on the filters themselves.
              # TODO: needs_prod_decisions gate envoy admin behind same OIDC dance
              routes:
              - match: { prefix: "/" }
                route: { cluster: ingress_self_admin }
              {{- range $t := .AdminTargets }}{{ if $t.Name }}
              - match: { prefix: "/workload/{{ $t.Name }}/" }
                route: { cluster: {{ $t.Name }}_admin, prefix_rewrite: "/" }
              {{- end }}{{ end }}
          http_filters:
          # oauth2 runs first: unauthenticated browser → 302 to dex.
          # Validated callback lands a HttpOnly cookie + bearer header.
          # Token + hmac secrets via file-based SDS — see Makefile
          # oauth2-secrets target + the SDS doc files mounted alongside
          # mesh certs at /run/ingress-mesh/oauth2-*.yaml.
          - name: envoy.filters.http.oauth2
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.oauth2.v3.OAuth2
              config:
                token_endpoint:
                  cluster: dex
                  uri: http://dex:5556/token
                  timeout: 5s
                authorization_endpoint: https://dex.{{ .ProjectName }}.{{ .LocalDomain }}:18443/auth
                redirect_uri: "https://www.{{ .ProjectName }}.{{ .LocalDomain }}:18443/oauth2/callback"
                redirect_path_matcher: { path: { exact: /oauth2/callback } }
                signout_path: { path: { exact: /oauth2/signout } }
                credentials:
                  client_id: localmesh-dev
                  token_secret:
                    name: oauth2_token_secret
                    sds_config:
                      path_config_source:
                        path: /run/ingress-mesh/oauth2-client-secret.yaml
                  hmac_secret:
                    name: oauth2_hmac_secret
                    sds_config:
                      path_config_source:
                        path: /run/ingress-mesh/oauth2-hmac.yaml
                auth_scopes: [openid, email, profile]
                # Skip the auth dance entirely on auth-opt-out vhosts (the
                # IdP itself + the envoy admin VH). pass_through_matcher
                # is AND-of-headers, so we use a single regex matcher on
                # :authority that covers every opt-out host. Per-VH
                # typed_per_filter_config doesn't disable oauth2 in
                # v1.31 — pass_through is the supported escape hatch.
                # TODO: needs_prod_decisions grafana joins the dance once
                # cross-subdomain cookie shape lands in Chunk 7.
                pass_through_matcher:
                - name: ":authority"
                  string_match:
                    safe_regex:
                      regex: "^(dex|envoy)\\.[^:]+(:[0-9]+)?$"
          # jwt_authn validates the dex-minted bearer on every subsequent
          # request and projects claims into x-user-* headers. Per-VH
          # disable on RequiresAuth=false hosts keeps the IdP/grafana
          # surface ungated.
          - name: envoy.filters.http.jwt_authn
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
              providers:
                dex:
                  issuer: http://dex:5556
                  remote_jwks: { http_uri: { uri: "http://dex:5556/keys", cluster: dex, timeout: 5s }, cache_duration: { seconds: 300 } }
                  forward: true
                  payload_in_metadata: jwt_claims
                  claim_to_headers:
                  - { header_name: x-user-id,    claim_name: sub }
                  - { header_name: x-user-email, claim_name: email }
                  - { header_name: x-user-name,  claim_name: preferred_username }
              # Per-route rules scoped by :authority — only hosts whose
              # plugin.toml entry has requires_auth=true (default) get
              # JWT-validated. Hosts the IdP itself sits on (dex.*) and
              # the envoy admin VH match no rule and pass through.
              rules:
              {{- range $r := .Routes }}{{ if $r.RequiresAuth }}
              - match:
                  prefix: "/"
                  headers:
                  - name: ":authority"
                    string_match: { exact: "{{ $r.Host }}" }
                requires: { provider_name: dex }
              {{- end }}{{ end }}
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
      {{ include "mesh.envoy.tls_terminate_self_signed" (dict "CertDir" "/run/ingress-mesh") | indent 6 | trim }}

  - name: stats
    address: { socket_address: { address: 0.0.0.0, port_value: 15090 } }
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: stats
          codec_type: AUTO
          route_config:
            virtual_hosts:
            - name: stats
              domains: ["*"]
              routes:
              - match: { prefix: "/stats/prometheus" }
                route: { cluster: admin_loopback }
          http_filters:
          - name: envoy.filters.http.router
            typed_config: { "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router }

  clusters:
  {{- range $r := .Routes }}
  - name: {{ $r.Cluster }}
    type: STRICT_DNS
    connect_timeout: 1s
    {{- if $r.RequiresAuth }}
    # Mesh-participating upstreams speak gRPC/HTTP2 over mTLS.
    http2_protocol_options: {}
    {{- end }}
    load_assignment:
      cluster_name: {{ $r.Cluster }}
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: {{ $r.Cluster }}, port_value: {{ $r.Port }} }
    {{ if not $r.RequiresAuth }}{{/* dex, grafana — mesh-exempt, plaintext or self-TLS, no mesh mTLS */}}{{ else }}
    {{ include "mesh.envoy.mtls_upstream" (dict "CertDir" "/run/ingress-mesh") | indent 4 }}
    {{ end }}
  {{- end }}

  - name: ingress_self_admin
    type: STATIC
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: ingress_self_admin
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: 127.0.0.1, port_value: 15000 }

  - name: admin_loopback
    type: STATIC
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: admin_loopback
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: 127.0.0.1, port_value: 15000 }

  {{- range $t := .AdminTargets }}{{ if $t.Name }}
  - name: {{ $t.Name }}_admin
    type: STRICT_DNS
    connect_timeout: 1s
    load_assignment:
      cluster_name: {{ $t.Name }}_admin
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: {{ $t.Name }}, port_value: 15000 }
  {{- end }}{{ end }}

  {{ include "mesh.envoy.otel_cluster" (dict "Endpoint" .OTelEndpoint) | indent 2 }}
