{{/*
Per-workload envoy sidecar bootstrap. One render per non-exempt workload.

Context: SidecarCtx
  .Name              workload container name
  .InboundPort       workload's [[services]] port (mTLS terminated here)
  .AppLoopbackPort   app's plaintext bind port (convention: InboundPort + 1)
  .Outbounds         []Edge  — per outbound peer
  .CertDir           /run/<Name>
  .OTelEndpoint      otel-collector:4317
  .EnvoyInbound      15006  — iptables redirect target for inbound
  .EnvoyOutbound     15001  — iptables redirect target for outbound
*/}}
admin:
  address:
    socket_address: { address: 0.0.0.0, port_value: 15000 }

node:
  id: {{ .Name }}-mesh
  cluster: {{ .Name }}

{{ include "mesh.envoy.tracing" (dict "ServiceName" (print .Name "-mesh") "Endpoint" .OTelEndpoint) }}

static_resources:
  listeners:
  - name: inbound
    address:
      socket_address: { address: 0.0.0.0, port_value: {{ .EnvoyInbound }} }
    {{ include "mesh.envoy.mtls_downstream" (dict "CertDir" .CertDir) | indent 4 }}
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: inbound
          codec_type: AUTO
          forward_client_cert_details: SANITIZE_SET
          set_current_client_cert_details:
            uri:    true
            subject: true
          {{ include "mesh.envoy.access_log" . | indent 10 }}
          route_config:
            virtual_hosts:
            - name: inbound
              domains: ["*"]
              routes:
              - match: { prefix: "/" }
                route: { cluster: app_loopback }
          http_filters:
          - name: envoy.filters.http.rbac
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.rbac.v3.RBAC
              # Foundation tier: allow-all-internal. Row 14 (cert-as-policy)
              # tightens this. TODO: needs_prod_decisions per-caller RBAC via cert OID
              rules:
                action: ALLOW
                policies:
                  allow-all:
                    permissions: [{ any: true }]
                    principals:  [{ any: true }]
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  - name: outbound
    address:
      socket_address: { address: 127.0.0.1, port_value: {{ .EnvoyOutbound }} }
    listener_filters:
    - name: envoy.filters.listener.original_dst
      typed_config:
        "@type": type.googleapis.com/envoy.extensions.filters.listener.original_dst.v3.OriginalDst
    filter_chains:
    {{- range $e := .Outbounds }}
    - filter_chain_match:
        destination_port: {{ $e.TargetPort }}
      filters:
      - name: envoy.filters.network.tcp_proxy
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
          stat_prefix: outbound_{{ $e.Target }}
          cluster: {{ $e.Target }}_mesh
    {{- end }}
    # Catch-all: anything not matched above forwards to egress-mesh
    - filters:
      - name: envoy.filters.network.tcp_proxy
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy
          stat_prefix: outbound_catchall
          cluster: egress_mesh

  - name: stats
    address:
      socket_address: { address: 0.0.0.0, port_value: 15090 }
    filter_chains:
    - filters:
      - name: envoy.filters.network.http_connection_manager
        typed_config:
          "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
          stat_prefix: stats
          codec_type: AUTO
          route_config:
            virtual_hosts:
            - name: stats
              domains: ["*"]
              routes:
              - match: { prefix: "/stats/prometheus" }
                route: { cluster: admin_loopback }
          http_filters:
          - name: envoy.filters.http.router
            typed_config:
              "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
  - name: app_loopback
    type: STATIC
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: app_loopback
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: 127.0.0.1, port_value: {{ .AppLoopbackPort }} }

  - name: admin_loopback
    type: STATIC
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: admin_loopback
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: 127.0.0.1, port_value: 15000 }

  {{- range $e := .Outbounds }}
  - name: {{ $e.Target }}_mesh
    type: STRICT_DNS
    connect_timeout: 0.250s
    http2_protocol_options: {}
    load_assignment:
      cluster_name: {{ $e.Target }}_mesh
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: {{ $e.Target }}-mesh, port_value: {{ $e.TargetPort }} }
    {{ include "mesh.envoy.mtls_upstream" (dict "CertDir" $.CertDir) | indent 4 }}
  {{- end }}

  - name: egress_mesh
    type: STRICT_DNS
    connect_timeout: 0.250s
    load_assignment:
      cluster_name: egress_mesh
      endpoints:
      - lb_endpoints:
        - endpoint:
            address:
              socket_address: { address: egress-mesh, port_value: 15001 }
    {{ include "mesh.envoy.mtls_upstream" (dict "CertDir" .CertDir) | indent 4 }}

  {{ include "mesh.envoy.otel_cluster" (dict "Endpoint" .OTelEndpoint) | indent 2 }}
