{{/*
mesh plugin compose template. Renders into .localmesh/localmesh.compose.yaml
alongside the other plugins. Per-workload sidecar + init blocks emitted
from .Workloads (sorted by container name).

Context expected (project-wide + workloads list):
  .Project.Name, .Project.LocalDomain
  .Workloads []{Name string, MeshExempt bool}   — populated by render.RunWith
*/}}
services:
  ingress-mesh:
    image: envoyproxy/envoy:v1.31-latest
    restart: unless-stopped
    # Caddy still owns 8443 until Chunk 5 retires it; coexist on 18443 till then.
    ports:
      - "18443:8443"   # TODO: needs_prod_decisions flip to 8443 when caddy retires in Chunk 5
    volumes:
      - ../../.localmesh/secrets/ingress-mesh:/run/ingress-mesh:ro
      - ../../.localmesh/envoy/ingress-mesh.yaml:/etc/envoy/envoy.yaml:ro
    environment:
      OIDC_CLIENT_ID:     ${LOCALMESH_OIDC_CLIENT_ID}
      OIDC_CLIENT_SECRET: ${LOCALMESH_OIDC_CLIENT_SECRET}
      DEX_ISSUER:         http://dex:5556
      DEX_JWKS_URI:       http://dex:5556/keys
      OAUTH2_HMAC_SECRET: ${LOCALMESH_OIDC_CLIENT_SECRET}
    depends_on:
      dex:
        condition: service_healthy
    labels:
      prometheus.io/scrape: "true"
      prometheus.io/port:   "15090"
      prometheus.io/path:   "/stats/prometheus"
      metrics.service_name: envoy
      metrics.module_name:  mesh
      metrics.owned_by:     sre@example.com
      mesh.role:            ingress

  egress-mesh:
    image: envoyproxy/envoy:v1.31-latest
    restart: unless-stopped
    volumes:
      - ../../.localmesh/secrets/egress-mesh:/run/egress-mesh:ro
      - ../../.localmesh/envoy/egress-mesh.yaml:/etc/envoy/envoy.yaml:ro
    labels:
      prometheus.io/scrape: "true"
      prometheus.io/port:   "15090"
      prometheus.io/path:   "/stats/prometheus"
      metrics.service_name: envoy
      metrics.module_name:  mesh
      metrics.owned_by:     sre@example.com
      mesh.role:            egress

{{ range $w := .Workloads }}{{ if not $w.MeshExempt }}
  {{ $w.Name }}-mesh-init:
    image: busybox:1.37
    network_mode: "service:{{ $w.Name }}"
    cap_add: ["NET_ADMIN"]
    volumes:
      - ../../.localmesh/envoy/{{ $w.Name }}-mesh-init.sh:/init.sh:ro
    command: ["/init.sh"]
    restart: "no"
    depends_on:
      {{ $w.Name }}:
        condition: service_started

  {{ $w.Name }}-mesh:
    image: envoyproxy/envoy:v1.31-latest
    network_mode: "service:{{ $w.Name }}"
    restart: unless-stopped
    volumes:
      - ../../.localmesh/secrets/{{ $w.Name }}:/run/{{ $w.Name }}:ro
      - ../../.localmesh/envoy/{{ $w.Name }}-mesh.yaml:/etc/envoy/envoy.yaml:ro
    depends_on:
      {{ $w.Name }}-mesh-init:
        condition: service_completed_successfully
      {{ $w.Name }}:
        condition: service_started
    labels:
      prometheus.io/scrape: "true"
      prometheus.io/port:   "15090"
      prometheus.io/path:   "/stats/prometheus"
      metrics.service_name: envoy
      metrics.module_name:  mesh
      metrics.owned_by:     sre@example.com
      mesh.role:            sidecar
{{ end }}{{ end }}
