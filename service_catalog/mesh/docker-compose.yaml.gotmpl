{{/*
mesh plugin compose template. Renders into .localmesh/localmesh.compose.yaml
alongside the other plugins. Per-workload sidecar + init blocks emitted
from .Workloads (sorted by container name).

Context expected (project-wide + workloads list):
  .Project.Name, .Project.LocalDomain
  .Workloads []{Name string, MeshExempt bool}   — populated by render.RunWith

Certs travel as docker compose secrets (not bind mounts). The compose
secrets driver lands files inside the container at the declared target
path with a fresh mode, regardless of host-side ownership. That sidesteps
the uid mismatch between the envoy image's drop-priv (uid 101) and the
host bind-mount's uid (1000). TODO: needs_prod_decisions cert delivery
via SPIRE Workload API or cert-manager Secret mount.
*/}}
secrets:
  ingress-mesh_id_crt:
    file: ../../.localmesh/secrets/ingress-mesh/id.crt
  ingress-mesh_id_key:
    file: ../../.localmesh/secrets/ingress-mesh/id.key
  ingress-mesh_trust_ca:
    file: ../../.localmesh/secrets/ingress-mesh/trust.ca.crt
  # SDS-shaped GenericSecret documents the envoy oauth2 filter reads via
  # path_config_source. See Makefile oauth2-secrets target. File-based SDS
  # sidesteps the v1.31 static_resources.secrets duplicate-name trap.
  ingress-mesh_oauth2_client_secret:
    file: ../../.localmesh/secrets/ingress-mesh/oauth2-client-secret.yaml
  ingress-mesh_oauth2_hmac:
    file: ../../.localmesh/secrets/ingress-mesh/oauth2-hmac.yaml
  egress-mesh_id_crt:
    file: ../../.localmesh/secrets/egress-mesh/id.crt
  egress-mesh_id_key:
    file: ../../.localmesh/secrets/egress-mesh/id.key
  egress-mesh_trust_ca:
    file: ../../.localmesh/secrets/egress-mesh/trust.ca.crt
{{- range $w := .Workloads }}{{ if not $w.MeshExempt }}
  {{ $w.Name }}-mesh_id_crt:
    file: ../../.localmesh/secrets/{{ $w.Name }}/id.crt
  {{ $w.Name }}-mesh_id_key:
    file: ../../.localmesh/secrets/{{ $w.Name }}/id.key
  {{ $w.Name }}-mesh_trust_ca:
    file: ../../.localmesh/secrets/{{ $w.Name }}/trust.ca.crt
{{- end }}{{ end }}

services:
  ingress-mesh:
    image: envoyproxy/envoy:v1.31-latest
    entrypoint: ["envoy"]
    command: ["-c", "/etc/envoy/envoy.yaml"]
    restart: unless-stopped
    # Caddy still owns 8443 until Chunk 5 retires it; coexist on 18443 till then.
    ports:
      - "18443:8443"   # TODO: needs_prod_decisions flip to 8443 when caddy retires in Chunk 5
    secrets:
      - source: ingress-mesh_id_crt
        target: /run/ingress-mesh/id.crt
        mode: 0444
      - source: ingress-mesh_id_key
        target: /run/ingress-mesh/id.key
        mode: 0440
      - source: ingress-mesh_trust_ca
        target: /run/ingress-mesh/trust.ca.crt
        mode: 0444
      - source: ingress-mesh_oauth2_client_secret
        target: /run/ingress-mesh/oauth2-client-secret.yaml
        mode: 0440
      - source: ingress-mesh_oauth2_hmac
        target: /run/ingress-mesh/oauth2-hmac.yaml
        mode: 0440
    volumes:
      - ../../.localmesh/envoy/ingress-mesh.yaml:/etc/envoy/envoy.yaml:ro
    depends_on:
      dex:
        condition: service_healthy
    labels:
      prometheus.io/scrape: "true"
      prometheus.io/port:   "15090"
      prometheus.io/path:   "/stats/prometheus"
      metrics.service_name: envoy
      metrics.module_name:  mesh
      metrics.owned_by:     sre@example.com
      mesh.role:            ingress

  egress-mesh:
    image: envoyproxy/envoy:v1.31-latest
    entrypoint: ["envoy"]
    command: ["-c", "/etc/envoy/envoy.yaml"]
    restart: unless-stopped
    secrets:
      - source: egress-mesh_id_crt
        target: /run/egress-mesh/id.crt
        mode: 0444
      - source: egress-mesh_id_key
        target: /run/egress-mesh/id.key
        mode: 0440
      - source: egress-mesh_trust_ca
        target: /run/egress-mesh/trust.ca.crt
        mode: 0444
    volumes:
      - ../../.localmesh/envoy/egress-mesh.yaml:/etc/envoy/envoy.yaml:ro
    labels:
      prometheus.io/scrape: "true"
      prometheus.io/port:   "15090"
      prometheus.io/path:   "/stats/prometheus"
      metrics.service_name: envoy
      metrics.module_name:  mesh
      metrics.owned_by:     sre@example.com
      mesh.role:            egress

{{ range $w := .Workloads }}{{ if not $w.MeshExempt }}
  {{ $w.Name }}-mesh-init:
    # busybox doesn't ship iptables; alpine + apk add is the smallest viable shape.
    # TODO: needs_prod_decisions swap to a pre-built iptables-init image for prod
    image: alpine:3.20
    network_mode: "service:{{ $w.Name }}"
    cap_add: ["NET_ADMIN"]
    volumes:
      - ../../.localmesh/envoy/{{ $w.Name }}-mesh-init.sh:/init.sh:ro
    command: ["sh", "-c", "apk add --no-cache iptables >/dev/null && /init.sh"]
    restart: "no"
    depends_on:
      {{ $w.Name }}:
        condition: service_started

  {{ $w.Name }}-mesh:
    image: envoyproxy/envoy:v1.31-latest
    entrypoint: ["envoy"]
    command: ["-c", "/etc/envoy/envoy.yaml"]
    network_mode: "service:{{ $w.Name }}"
    restart: unless-stopped
    secrets:
      - source: {{ $w.Name }}-mesh_id_crt
        target: /run/{{ $w.Name }}/id.crt
        mode: 0444
      - source: {{ $w.Name }}-mesh_id_key
        target: /run/{{ $w.Name }}/id.key
        mode: 0440
      - source: {{ $w.Name }}-mesh_trust_ca
        target: /run/{{ $w.Name }}/trust.ca.crt
        mode: 0444
    volumes:
      - ../../.localmesh/envoy/{{ $w.Name }}-mesh.yaml:/etc/envoy/envoy.yaml:ro
    depends_on:
      {{ $w.Name }}-mesh-init:
        condition: service_completed_successfully
      {{ $w.Name }}:
        condition: service_started
    labels:
      prometheus.io/scrape: "true"
      prometheus.io/port:   "15090"
      prometheus.io/path:   "/stats/prometheus"
      metrics.service_name: envoy
      metrics.module_name:  mesh
      metrics.owned_by:     sre@example.com
      mesh.role:            sidecar
{{ end }}{{ end }}
