{
  "uid": "infra-modules",
  "title": "Catalogue: infra modules",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What's a module?",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Each catalogue module (`service_catalog/<name>/`) stamps its telemetry with `module_name=<name>` plus an `owned_by` contact. Scrape jobs set them on prom labels; apps set them via `OTEL_RESOURCE_ATTRIBUTES`. This page is the high-level roster — what's deployed, who owns it, how active it is."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Module roster (scrape + tracing)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "uid": "vm", "type": "prometheus" },
      "targets": [
        {
          "refId": "scrape",
          "expr": "count by (module_name, owned_by) (up)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "traces",
          "expr": "count by (module_name, owned_by) (traces_spanmetrics_calls_total)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "module_name": "Module",
              "owned_by": "Owner",
              "Value #scrape": "Scrape targets",
              "Value #traces": "Trace series"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Trace request rate by module",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "uid": "vm", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (module_name) (rate(traces_spanmetrics_calls_total[1m]))",
          "legendFormat": "{{module_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 4,
      "type": "nodeGraph",
      "title": "Service graph (caller → callee)",
      "description": "Tempo's serviceMap query — nodes are services, edges are CLIENT→SERVER call pairs observed in spans. Click an edge to inspect example traces.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "pluginVersion": "11.4.0",
      "options": {
        "edges": {},
        "nodes": {}
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "serviceMap",
          "tableType": "traces",
          "limit": 20
        }
      ]
    }
  ]
}
