{
  "uid": "service-glance",
  "title": "Service at a glance",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "uid": "vm", "type": "prometheus" },
        "query": { "query": "label_values(traces_spanmetrics_calls_total, service)" },
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Starter template",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Generic 'this service at a glance' suggested by ops as the minimum for a containerized microservice. RED on top (Rate/Errors/Duration from Tempo spanmetrics), USE below (container CPU/memory from cadvisor), logs at the bottom. Fork it per team and add what's domain-specific."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request rate (RED: rate)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 3 },
      "datasource": { "uid": "vm", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"$service\"}[1m]))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (RED: errors)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 3 },
      "datasource": { "uid": "vm", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"$service\", status_code=\"STATUS_CODE_ERROR\"}[1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency (RED: duration)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 3 },
      "datasource": { "uid": "vm", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"$service\"}[5m])))"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Container CPU (USE: utilization)",
      "description": "Filtered on container `name` containing the service — works when compose names align with service.name (server, www). Adjust the regex when they don't.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "uid": "vm", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".*$service.*\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container memory (USE: utilization)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "uid": "vm", "type": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".*$service.*\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent logs",
      "description": "Logs filtered by container_id whose name matches the service. Until app-side OTLP logs land, filelog can't tag logs with service.name — see catalogue/logging notes.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "datasource": { "uid": "loki", "type": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{container_id=~\".+\"} |~ \"(?i)$service\""
        }
      ]
    }
  ]
}
